datasource db {
  provider = "postgres"
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native"]
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  password  String
  roles     Role[]

  fingerprint       UserFingerprint[]
  passkeys          PasskeyCredential[]
  passkeyChallenges PasskeyChallenge[]
}

model Role {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  users     User[]
  subroles  Subrole[]
}

model Host {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String
  hostname    String
  caKey       String
  subroles    Subrole[]
  fingerprint Bytes?    @unique
}

model HostVerification {
  id          String   @id
  createdAt   DateTime @default(now())
  fingerprint Bytes    @unique
}

model KeyLoginChallenge {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  nonce       String
  fingerprint Bytes
}

model PasskeyCredential {
  id                   String    @id @default(uuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastUsedAt           DateTime?
  credentialId         String    @unique
  publicKey            Bytes
  counter              Int
  transports           String[]
  name                 String?
  credentialDeviceType String?
  credentialBackedUp   Boolean?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String

  @@index([userId])
}

model PasskeyChallenge {
  id        String               @id @default(uuid())
  createdAt DateTime             @default(now())
  expiresAt DateTime
  challenge String               @unique
  type      PasskeyChallengeType
  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([type, challenge])
  @@index([expiresAt])
}

model Subrole {
  id             String      @id @default(uuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  username       String
  role           Role        @relation(fields: [roleId], references: [id])
  host           Host        @relation(fields: [hostId], references: [id])
  hostId         String
  roleId         String
  extensions     Extension[]
  force_command  String?
  source_address String?
}

model UserFingerprint {
  createdAt   DateTime @default(now())
  fingerprint Bytes    @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

enum Extension {
  permit_X11_forwarding
  permit_agent_forwarding
  permit_port_forwarding
  permit_pty
  permit_user_rc
}

enum PasskeyChallengeType {
  REGISTRATION
  AUTHENTICATION
}
